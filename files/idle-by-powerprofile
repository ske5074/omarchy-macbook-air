#!/bin/bash
# Run the screensaver, lock, and suspend on idle, with times based on the active power
# profile. Runs once, then follows power-profiles-daemon changes over D-Bus.
# swayidle runs all three with Omarchy's own commands, and locks the screen before every
# sleep (idle or manual). Omarchy's idle timer is pushed out of the way instead of fed
# the times, because every shell.json write makes the shell rebuild the bar.
#
# Usage:
#   idle-by-powerprofile                       run the service
#   idle-by-powerprofile set <name> <seconds>  change screensaver|lock|suspend for the
#                                              active profile (suspend 0 = never)

config="$HOME/.config/omarchy/shell.json"
# Times per profile, in seconds; created with the defaults below if missing
times="$HOME/.config/omarchy/idle-by-powerprofile.json"
stay_awake="$HOME/.local/state/omarchy/indicators/stay-awake"
# Current times for the bar's power panel, as "<name>\t<seconds>" lines
status="$HOME/.local/state/omarchy/idle-by-powerprofile"
swayidle_pid=""

ensure_times() {
  [[ -f $times ]] && return
  mkdir -p "$(dirname "$times")"
  cat >"$times" <<'EOF'
{
  "performance": { "screensaver": 1800, "lock": 3600, "suspend": 0 },
  "balanced": { "screensaver": 900, "lock": 1800, "suspend": 600 },
  "power-saver": { "screensaver": 300, "lock": 600, "suspend": 300 }
}
EOF
}

set_time() {
  local name=$1 seconds=$2 profile tmp
  [[ $name =~ ^(screensaver|lock|suspend)$ && $seconds =~ ^[0-9]+$ ]] || {
    echo "Usage: idle-by-powerprofile set <screensaver|lock|suspend> <seconds>" >&2
    exit 1
  }
  [[ $seconds -gt 0 || $name == suspend ]] || { echo "$name must be at least 1 second" >&2; exit 1; }

  ensure_times
  profile=$(powerprofilesctl get) || exit
  tmp=$(mktemp "$times.XXXXXX") &&
    jq --indent 2 --arg p "$profile" --arg n "$name" --argjson s "$seconds" '.[$p][$n] = $s' "$times" >"$tmp" &&
    mv "$tmp" "$times"

  # Tell the running service to re-apply
  systemctl --user kill --kill-whom=main -s HUP idle-by-powerprofile.service 2>/dev/null || true
}

if [[ ${1:-} == "set" ]]; then
  set_time "${2:-}" "${3:-}"
  exit
fi

lock_and_wait() {
  omarchy system lock
  for _ in {1..20}; do
    [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]] && return
    sleep 0.1
  done
}
export -f lock_and_wait

start_swayidle() {
  local screensaver=$1 lock=$2 suspend=$3
  # Every idle action respects Omarchy's Stay Awake toggle
  local awake="[ -e '$stay_awake' ]"
  local args=(-w before-sleep 'bash -c lock_and_wait')

  # resume: like Omarchy's idle service, restore displays and keyboard backlight
  args+=(timeout "$screensaver" "$awake || [ \"\$(omarchy-shell lock isLocked 2>/dev/null)\" = true ] || omarchy-launch-screensaver"
    resume omarchy-system-wake)
  args+=(timeout "$lock" "$awake || omarchy-system-lock" resume omarchy-system-wake)
  ((suspend > 0)) && args+=(timeout "$suspend" "$awake || systemctl suspend")

  [[ -n $swayidle_pid ]] && kill "$swayidle_pid" 2>/dev/null && wait "$swayidle_pid" 2>/dev/null
  swayidle "${args[@]}" &
  swayidle_pid=$!
}

apply() {
  local profile screensaver lock suspend tmp
  profile=$(powerprofilesctl get 2>/dev/null) || return
  ensure_times
  read -r screensaver lock suspend < <(jq -r --arg p "$profile" '
    (.[$p] // .balanced) as $t
    | [$t.screensaver // 900, $t.lock // 1800, $t.suspend // 0] | @tsv' "$times")
  [[ -n $suspend ]] || return

  start_swayidle "$screensaver" "$lock" "$suspend"

  mkdir -p "$(dirname "$status")"
  printf 'profile\t%s\nscreensaver\t%s\nlock\t%s\nsuspend\t%s\n' "$profile" "$screensaver" "$lock" "$suspend" >"$status"

}

# Push Omarchy's own idle timer out to a week so it never fires before ours. Written
# only when it differs, since each shell.json write rebuilds the bar.
park_omarchy_idle() {
  local week=604800 tmp
  [[ -f $config ]] || return
  [[ $(jq -c '[.idle.screensaver, .idle.lock]' "$config") == "[$week,$week]" ]] && return

  tmp=$(mktemp "$config.XXXXXX") &&
    jq --indent 2 --argjson w "$week" '.idle.screensaver = $w | .idle.lock = $w' "$config" >"$tmp" &&
    cat "$tmp" >"$config"
  rm -f "$tmp"
}

trap '[[ -n $swayidle_pid ]] && kill "$swayidle_pid" 2>/dev/null' EXIT
trap apply HUP

park_omarchy_idle
apply
while true; do
  if read -r line; then
    [[ $line == *ActiveProfile* ]] && apply
  else
    # A HUP interrupts read with a status above 128; anything else means gdbus exited
    (($? > 128)) || break
  fi
done < <(gdbus monitor --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles)

# gdbus exited unexpectedly; let systemd restart us
exit 1
