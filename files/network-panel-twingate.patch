+      waitForEnd: true
+      onStreamFinished: root.twingateStatus = text.trim().toLowerCase()
+    }
+    onExited: function(code) { root.twingateInstalled = code !== 3 }
+  }
+
+  Timer {
+    interval: root.opened ? 3000 : 15000
+    repeat: true
+    running: true
+    triggeredOnStart: true
+    onTriggered: if (!twingateProc.running) twingateProc.running = true
+  }
